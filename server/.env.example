# Copy this file to ".env" and edit the values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stayevent
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Automatically load sample hotels/venues + demo accounts when the database is empty
AUTO_SEED=true
